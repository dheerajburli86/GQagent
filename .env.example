# Copy to .env for local runs (`npm run doctor`, `npm run ask`, `npm start`).
# On Railway, set these in the service's Variables tab instead. Never commit .env.

# --- Telegram. Create the bot with @BotFather (DEPLOY.md, Step 1). This is the only
# Telegram setting you need: anyone can then open the bot, tap Start and use it.
TELEGRAM_BOT_TOKEN=
# Optional, for later: comma-separated Telegram IDs. Leave EMPTY for an open bot.
#   TELEGRAM_ALLOWED_USER_IDS   only these people may use the bot
#   TELEGRAM_ALLOWED_GROUP_IDS  only these groups are answered
#   TELEGRAM_ADMIN_USER_IDS     only these people may change stock lists / see /status
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_GROUP_IDS=
TELEGRAM_ADMIN_USER_IDS=

# --- Model: DeepInfra is the only model provider (one key).
DEEPINFRA_API_KEY=
AGENT_MODEL=google/gemini-2.5-flash
# Optional second DeepInfra model (same key), used only if the first has an outage.
AGENT_FALLBACK_MODEL=
AGENT_MAX_OUTPUT_TOKENS=8192

# --- Live market data (optional, READ-ONLY). The heatmap project's URL and a key.
# Without these, market questions are answered from general knowledge only.
HEATMAP_SUPABASE_URL=https://xmcvsnollphnsonaupzt.supabase.co
HEATMAP_SUPABASE_KEY=

# --- xAI Grok (optional). Used only when a message says @grok (Grok answers, with live
# web search) or @grok @deepinfra (both answer, DeepInfra merges). See DEPLOY.md, Step 2d.
XAI_API_KEY=
AGENT_GROK_MODEL=grok-4.3
# Research model for web_research (defaults to AGENT_GROK_MODEL).
AGENT_GROK_RESEARCH_MODEL=

# --- GitHub: fine-grained token, Contents: Read-only, on the four repos.
GITHUB_READ_TOKEN=

# --- SEC EDGAR (US filings and reported financials): SEC asks every client to say who
# it is, as 'Company name contact@email'. Recommended; no key or signup needed.
SEC_USER_AGENT=GQuants Research you@gquants.com

# --- Spend caps in tokens. 0 = no cap (pay as you go). /status shows the spend.
AGENT_DAILY_TOKENS_PER_USER=0
AGENT_MONTHLY_TOKENS=0

# --- Limits (defaults shown)
AGENT_RATE_PER_MIN=12
AGENT_MAX_STEPS=12
AGENT_REQUEST_DEADLINE_MS=180000
AGENT_HISTORY_TURNS=6

# --- Scheduled monitoring tasks (created in Telegram; see docs/SAMPLE_QUESTIONS.md)
TASKS_ENABLED=true
TASK_CONCURRENCY=3
TASK_MIN_INTERVAL_MINUTES=15
TASK_MAX_PER_CHAT=100
TASK_MAX_TOTAL=500
TASK_MAX_STEPS=16
TASK_DEADLINE_MS=300000
TASK_MAX_FAILURES=5

# --- Storage: settings, budgets and tasks (a Railway volume mounted at /data)
DATA_DIR=/data

# --- Repo snapshots
SNAPSHOT_REFRESH_MINUTES=360
SNAPSHOT_MAX_FILE_KB=400
SNAPSHOT_MAX_TOTAL_MB=80
